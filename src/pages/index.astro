---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/react-components/navbar";
import HeroContent from "../components/react-components/HeroContent";
import BackgroundCircles from "../components/ui/backgroundcircles";
import FloatingNav from "../components/ui/floatingnav";
import Spacer from "../components/react-components/spacer";
import CLIDemo from "../components/react-components/CliDemo";
import DashedLines from "../components/ui/dashedlines";
import GridOverlay from "../layouts/GridOverlay";
import Seo from "../components/seo/Seo.astro";
import SafetyBadges from "../components/ui/SafetyBadge";

const pageTitle = "Omni";
const pageDescription = "Convert files directly in your terminal. Supports PDF, DOCX, PNG, TXT, and more.";

import "./src/styles/global.css";
import Pricing from "@/components/react-components/pricing";
import Footer from "@/components/react-components/footer";
import SafetyBento from "@/components/react-components/ConversionTimeline";
---

<Seo title={pageTitle} description={pageDescription} />

<Layout>
  <div class="grain-overlay pointer-events-none"></div>

  <Navbar client:load />
  <FloatingNav client:load />
  <BackgroundCircles client:load />

  <GridOverlay client:load />

  <main class="relative z-30 max-w-full mx-auto px-6 pt-20">
    <HeroContent client:load />

    <div class="relative z-30 max-w-full mx-auto px-6 mt-30">
      <div class="absolute -top-5 left-0 w-full z-40 pointer-events-none">
        <DashedLines orientation="hr" />
      </div>

      <Spacer client:load />

      <div class="absolute -bottom-5 left-0 w-full z-40 pointer-events-none">
        <DashedLines orientation="hr" />
      </div>
    </div>
  </main>

  <div class="mt-40">
    <SafetyBadges client:visible />
  </div>
  
  <div class="mt-40">
    <SafetyBento client:load/>
  </div>

  <div class="mt-40">
    <Pricing />
  </div>

  <div class="mt-200">
    <CLIDemo client:visible/>
  </div>
  <div class="mt-40">
    <Footer client:visible/>
  </div>
</Layout>
